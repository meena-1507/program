import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] p = new int[n];
        int[] s = new int[n];
        for(int i = 0; i < n; i++) {
            p[i] = sc.nextInt();
        }
        Stack<Integer> st = new Stack<>();
        for(int i = 0; i < n; i++){
            while(!st.empty() && p[st.peek()] <= p[i]){
                st.pop();
            }
            if(st.isEmpty()) {
                s[i] = i + 1;
            } else {
                s[i] = i - st.peek();
            }
            st.push(i);
        }
        for(int i = 0; i < n; i++) {
            System.out.println(s[i]);
        }
    }
}
